# ==============================================================================
# GILBERT COMMAND CENTER — ENVIRONMENT VARIABLES TEMPLATE
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO SOURCE CONTROL.
# Configure these in Netlify Environment Variables or local .env file.
# ==============================================================================

# Google OAuth & Gmail Intake API (Server-side Netlify Functions)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_INTAKE_ACCOUNT=gilbert.cgpt@gmail.com
GMAIL_CALENDAR_INTAKE_ADDRESS=gilbert.cgpt+calendar@gmail.com
GMAIL_INTAKE_LABEL=Command Center Intake
GMAIL_REFRESH_TOKEN=

# Firebase Client & Admin Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=gilbert-command-center-ff543
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_OWNER_UID=

# Local AI / Ollama Settings (Optional Fallback)
AI_PROVIDER=Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
